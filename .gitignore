# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local tooling
scripts/.venv-world/

# original / unprocessed audio (large wavs). game uses public/audio/world/*.mp3
/audio-src/

# high-res press photos (16-46 MB each). uploaded to Vercel Blob via
# `npm run photos:upload`; the site reads src/lib/epk/photos.json
/photos-src/

# original music video export (~230 MB). web encode uploaded to Vercel Blob via
# `npm run video:upload -- video-src/<file>`; the site reads src/lib/epk/video.json
/video-src/
